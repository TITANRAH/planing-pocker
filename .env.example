# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase.
# .env.local está ignorado por git: nunca subas claves al repositorio.

# Base de datos (Supabase → Connect → ORMs → Prisma)
# Pooler en modo transacción (puerto 6543), usado por la app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa o pooler en modo sesión (puerto 5432), usada solo por prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Realtime en el cliente (Supabase → Project Settings → API Keys → publishable key)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
